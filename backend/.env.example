# ========================================================
# QuantumMedAI - Backend Environment Variables
# ========================================================

# 1. High-Speed LLM Inference API Keys (Choose one or more)
# --------------------------------------------------------
# Cerebras Wafer-Scale Engine (Ultra-fast ~2,100 tokens/sec)
# Get your free/pro key at https://cloud.cerebras.ai/
CEREBRAS_API_KEY=csk-your_cerebras_api_key_here

# Groq LPU Inference (Sub-second speed)
# Get your free key at https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Optional)
OPENAI_API_KEY=your_openai_api_key_here


# 2. Database & Auth Configuration
# --------------------------------------------------------
# Local SQLite default: sqlite:///./quantummed.db
# Render / PostgreSQL example: postgresql://user:pass@host:5432/quantummed_db
DATABASE_URL=sqlite:///./quantummed.db

SECRET_KEY=quantummed_ai_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Server Configuration
# --------------------------------------------------------
PORT=8000
ENVIRONMENT=production
